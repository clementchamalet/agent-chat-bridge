# Configure one or both channels. Only listed users may send commands.
# WhatsApp phone numbers are E.164 digits without "+".
ALLOWED_NUMBERS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=3000
GRAPH_API_VERSION=

# Telegram user IDs are numeric, not usernames. Uses private chats and long polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Agent configuration.
DEFAULT_ENGINE=claude
DEFAULT_MODEL=
AGENT_PERMISSION_MODE=review
DEFAULT_CWD=~/Projects
WORKSPACES_ROOT=~/Projects
PROJECT_SEARCH_ROOTS=~/Desktop,~/Documents,~/Projects

# Storage and operations.
DB_PATH=./data/bridge.sqlite3
PROMPT_IDLE_MS=1400
PROGRESS_CHECK_MS=20000
WAITING_TIMEOUT_MINUTES=30
MAX_TASK_HOURS=12
REAP_IDLE_HOURS=48
MAX_ACTIVE_SESSIONS=8
MAX_MESSAGES_PER_MINUTE=60
WEBHOOK_MAX_AGE_MINUTES=10
LOG_LEVEL=info
